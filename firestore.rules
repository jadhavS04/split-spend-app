rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /groups/{g} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
      match /members/{m} { allow read, create, update: if request.auth != null; allow delete: if false; }
      match /expenses/{e} { allow read, create, update: if request.auth != null; allow delete: if false; }
      match /log/{l} { allow read, create: if request.auth != null; allow update, delete: if false; }
    }
  }
}
